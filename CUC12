            }

            const isGuidingTo = state.isGuiding ? `Actualmente guiando a: ${state.destination.name} (${state.destination.code}). Nodo actual: ${state.currentNodeKey}. ` : '';
            
            const systemPrompt = `Eres el asistente de voz contextual (Guía Dinámica) del Bloque 12 de la Universidad de la Costa (CUC). Tu objetivo es proporcionar información útil y concisa para ayudar a una persona con discapacidad visual a orientarse. Responde siempre en español, de forma clara, directa y auditiva. Utiliza la información de Google Search si es necesaria para contexto general, pero prioriza la ayuda de orientación. Máximo 50 palabras.`;

            const userQuery = `${isGuidingTo} El usuario pregunta: ${query}. Genera una respuesta útil.`;
            
            if ($currentState) $currentState.textContent = "CONSULTANDO ASISTENTE IA... Por favor espere.";
            if ($askGeminiBtn) {
                $askGeminiBtn.disabled = true;
                $askGeminiBtn.textContent = 'Consultando...';
            }
            
            const payload = {
                contents: [{ parts: [{ text: userQuery }] }],
                tools: [{ "google_search": {} }],
                systemInstruction: { parts: [{ text: systemPrompt }] },
            };

            try {
                const result = await fetchWithExponentialBackoff(`${GEMINI_API_URL}${apiKey}`, payload);
                const text = result?.candidates?.[0]?.content?.parts?.[0]?.text || "Disculpa, no pude procesar la consulta en este momento.";
                
                if ($currentState) $currentState.textContent = `Respuesta del Asistente IA: ${text}`;
                speak(text);
                vibrate('long');

            } catch (error) {
                if ($currentState) $currentState.textContent = "Error al conectar con la IA. Intente de nuevo más tarde.";
                speak("Error del sistema. No se pudo obtener la respuesta.");
                console.error("Gemini API Error:", error);
            } finally {
                if ($askGeminiBtn) {
                    $askGeminiBtn.disabled = false;
                    $askGeminiBtn.textContent = '✨ Consultar IA';
                }
            }
        }

        // ====================================================================
        // LÓGICA DE NAVEGACIÓN
        // ====================================================================

        function setupIndex() {
            for (const code in destinationsRaw) {
                const dest = destinationsRaw[code];
                const normalizedName = normalize(dest.name);
                const normalizedCode = normalize(code);
                
                const floorLabel = dest.floor === 0 ? "Planta Baja" : `Piso ${dest.floor}`;
                const destinationNode = `D${code}`;
                const elevatorNode = `N${dest.floor}A`;
                const groundNode = 'N00';
                
                let route;
                
                if (dest.floor === 0) {
                    route = [groundNode, destinationNode];
                } else {
                    route = ['N0A', elevatorNode, destinationNode];
                }
                
                const finalDest = {
                    code: code,
                    name: dest.name,
                    floor: dest.floor,
                    floor_label: floorLabel,
                    route: route,
                    startNode: 'N01',
                    destinationNode: destinationNode
                };

                DEST_INDEX[normalizedCode] = finalDest;
                DEST_INDEX[normalizedName] = finalDest;
                
                mapData.nodes[destinationNode] = {
                    name: `${dest.name} (${code})`,
                    instructions: {
                        [route[route.length - 2]]: {
                            instruction: `Ha llegado a la sala ${dest.name} (${code}) en el ${floorLabel}. La puerta está a su derecha. Fin de la ruta.`,
                            vibration: "long"
                        }
                    }
                };
            }
        }
        
        function resolveDestinationFlexible(query) {
            const q = normalize(query);
            const allResults = [];
            const resultKeys = {};
            
            if (DEST_INDEX[q]) return [DEST_INDEX[q]];

            for (const key in DEST_INDEX) {
                const dest = DEST_INDEX[key];
                if (key.includes(q)) {
                    if (!resultKeys[dest.code]) {
                        allResults.push(dest);
                        resultKeys[dest.code] = true;
                    }
                }
            }
            return allResults;
        }

        function iniciarGuia(dest) {
            state.isGuiding = true;
            state.destination = dest;
            state.route = [...dest.route];
            state.currentStepIndex = 0;
            state.currentNodeKey = dest.startNode;
            
            if ($destinationInput) $destinationInput.classList.add('hidden');
            if ($activeGuidance) $activeGuidance.classList.remove('hidden');
            if ($currentDestination) $currentDestination.textContent = `${dest.name} - ${dest.floor_label}`;
            if ($currentNodeDisplay) $currentNodeDisplay.textContent = state.currentNodeKey;

            const initialInstruction = mapData.nodes[state.currentNodeKey].instructions.default;
            updateInstruction(initialInstruction);

            const msg = `Ruta a ${dest.name} iniciada en el ${dest.floor_label}. Por defecto, usaremos la ruta accesible. ${initialInstruction}`;
            if ($currentState) $currentState.textContent = msg;
            speak(msg);
        }
        
        async function startNavigation() {
            const raw = $destinationText.value;
            if (!raw) {
                speak("Por favor, ingrese o hable un destino primero.");
                return;
            }
            
            const posibles = resolveDestinationFlexible(raw);

            if (posibles.length === 0) {
                const msg = "No encontré un salón con ese nombre. Intente de nuevo o diga el número del salón.";
                if ($currentState) $currentState.textContent = msg;
                speak(msg);
                vibrate("long");
                return;
            }

            if (posibles.length > 1) {
                const opciones = posibles.map(r => `${r.name} (${r.code})`).join(", ");
                
                const preguntaVisual = `MÚLTIPLES: Escoja uno y escriba su nombre o código completo: ${opciones}.`;
                if ($currentState) $currentState.textContent = preguntaVisual;

                const preguntaVoz = `Encontré varios salones. Por favor, escriba el nombre o código completo de su destino, como ${posibles[0].name} o ${posibles[0].code}.`;
                speak(preguntaVoz);
                return;
            }

            iniciarGuia(posibles[0]);
        }

        function simulateScan() {
            if (!state.isGuiding) {
                const msg = "Por favor, inicie una navegación primero.";
                if ($currentState) $currentState.textContent = msg;
                speak(msg);
                vibrate('long');
                return;
            }

            if (state.currentStepIndex >= state.route.length) {
                updateInstruction("Ruta completada. Por favor, detenga la guía.");
                vibrate('long');
                return;
            }

            const nextNodeKey = state.route[state.currentStepIndex];
            const previousNodeKey = state.currentStepIndex > 0 ? state.route[state.currentStepIndex - 1] : state.currentNodeKey;
            const nextNode = mapData.nodes[nextNodeKey];
            let instructionData;
            
            if (nextNode.instructions && nextNode.instructions[previousNodeKey]) {
                instructionData = nextNode.instructions[previousNodeKey];
            } else {
                 instructionData = { 
                     instruction: `Nodo táctil ${nextNodeKey} detectado. Avance recto 10 metros hasta el siguiente punto.`, 
                     vibration: 'turn' 
                 };
                 if (nextNodeKey.includes('A')) {
                    instructionData.instruction = `Nodo de Ascensor/Rampa en ${nextNode.name} detectado. Busque el ascensor y vaya al piso ${state.destination.floor}.`;
                 }
                 if (nextNodeKey.includes('00')) {
                    instructionData.instruction = `Nodo de Pasillo Principal detectado. Avance 15 metros en este pasillo.`;
                 }
            }

            state.currentNodeKey = nextNodeKey;
            state.currentStepIndex++;

            if ($currentNodeDisplay) $currentNodeDisplay.textContent = state.currentNodeKey;
            updateInstruction(instructionData.instruction);
            vibrate(instructionData.vibration);
            
            if (state.currentStepIndex === state.route.length) {
                if ($currentState) $currentState.textContent = `¡Ruta completada! Destino: ${state.destination.name}`;
            } else {
                if ($currentState) $currentState.textContent = `Nodo Táctil ${state.currentNodeKey} detectado. Siguiente paso...`;
            }
        }

        function stopNavigation() {
            if (state.isGuiding) {
                state.isGuiding = false;
                state.destination = null;
                state.route = [];
                state.currentStepIndex = 0;
                state.currentNodeKey = 'N01';
                
                if ($destinationInput) $destinationInput.classList.remove('hidden');
                if ($activeGuidance) $activeGuidance.classList.add('hidden');
                if ($currentState) $currentState.textContent = "Guía detenida. Inicie una nueva ruta.";
                if ($destinationText) $destinationText.value = '';
                updateInstruction("Esperando instrucción...");
                speak("Guía de navegación detenida.");
                vibrate('long');
            }
        }

        function populateDatalist() {
            if ($destinosDatalist) {
                const fragment = document.createDocumentFragment();
                const uniqueDestinations = Object.values(DEST_INDEX).filter((v,i,a)=> a.findIndex(t=>(t.code === v.code)) === i);
                
                uniqueDestinations.forEach(dest => {
                    let optionCode = document.createElement('option');
                    optionCode.value = dest.code;
                    optionCode.textContent = `${dest.code} - ${dest.name}`;
                    fragment.appendChild(optionCode);

                    let optionName = document.createElement('option');
                    optionName.value = dest.name;
                    fragment.appendChild(optionName);
                });

                $destinosDatalist.appendChild(fragment);
            }
        }

        // ====================================================================
        // MANEJADORES DE EVENTOS
        // ====================================================================

        // Handlers para los botones superiores e inferiores
        function toggleContrast() {
            state.highContrast = !state.highContrast;
            const text = state.highContrast ? 'Alto Contraste (ON)' : 'Alto Contraste (OFF)';
            const bottomText = state.highContrast ? 'Contraste' : 'Contraste';
            
            if ($toggleContrastBtn) $toggleContrastBtn.textContent = text;
            if ($bottomContrastBtn) $bottomContrastBtn.textContent = bottomText;
            
            if (state.highContrast) {
                $body.classList.add('high-contrast');
            } else {
                $body.classList.remove('high-contrast');
                $body.classList.remove('bg-gray-100', 'text-gray-800');
                $body.classList.add('bg-gray-100', 'text-gray-800');
            }
            speak(`Modo de alto contraste ${state.highContrast ? 'activado' : 'desactivado'}.`);
        }
        
        function toggleStairs() {
            state.stairsAvoidance = !state.stairsAvoidance;
            const text = state.stairsAvoidance ? 'Ruta Accesible (ON)' : 'Ruta con Escaleras (OFF)';
            const bottomText = state.stairsAvoidance ? 'Accesible (ON)' : 'Accesible (OFF)';
            
            if ($toggleStairsBtn) $toggleStairsBtn.textContent = text;
            if ($bottomStairsBtn) $bottomStairsBtn.textContent = bottomText;
            
            const msg = `Preferencia de ruta cambiada. Se prioriza ${state.stairsAvoidance ? 'rampas y ascensores' : 'escaleras'}.`;
            speak(msg);
            if ($currentState) $currentState.textContent = msg;
        }

        if ($toggleContrastBtn) $toggleContrastBtn.addEventListener('click', toggleContrast);
        if ($bottomContrastBtn) $bottomContrastBtn.addEventListener('click', toggleContrast);
        
        if ($toggleStairsBtn) $toggleStairsBtn.addEventListener('click', toggleStairs);
        if ($bottomStairsBtn) $bottomStairsBtn.addEventListener('click', toggleStairs);
        
        if ($bottomGeminiBtn) {
            $bottomGeminiBtn.addEventListener('click', () => {
                // Alternar visibilidad de la sección de consultas
                if ($geminiQuerySection) $geminiQuerySection.classList.toggle('hidden');
                $bottomGeminiBtn.classList.toggle('text-white');
                speak($geminiQuerySection && $geminiQuerySection.classList.contains('hidden') ? "Asistente de consulta cerrado." : "Asistente de consulta abierto. ¿Qué desea saber?");
            });
        }

        if ($startNavBtn) $startNavBtn.addEventListener('click', startNavigation);
        if ($simulateScanBtn) $simulateScanBtn.addEventListener('click', simulateScan);
        if ($stopNavBtn) $stopNavBtn.addEventListener('click', stopNavigation);
        if ($askGeminiBtn) $askGeminiBtn.addEventListener('click', askGeminiForHelp);
        if ($voiceInputBtn) {
            $voiceInputBtn.addEventListener('click', () => {
                 try {
                    if (state.isGuiding) { stopNavigation(); }
                    if (recognition) recognition.start();
                } catch (e) {
                    if (e.name !== 'InvalidStateError') {
                        speak("La función de reconocimiento de voz no pudo iniciarse.");
                    }
                }
            });
        }
        
        // Handlers para emergencia e incidentes (igual que antes)
        if ($emergencyBtn) {
            $emergencyBtn.addEventListener('click', () => {
                const emergencyMsg = "Modo de emergencia activado. La salida segura más cercana es en dirección contraria al pasillo central. Proceda con precaución.";
                updateInstruction(emergencyMsg);
                if ($currentState) $currentState.textContent = "ALERTA: Modo Emergencia Activado.";
                vibrate('long');
            });
        }

        if ($reportIncidentBtn) {
            $reportIncidentBtn.addEventListener('click', () => {
                const reportMsg = `Reporte de incidencia enviado: El QR ${state.currentNodeKey} no pudo ser leído, o hay un obstáculo. Un asistente está siendo notificado.`;
                updateInstruction(reportMsg);
                if ($currentState) $currentState.textContent = "Incidencia Reportada.";
                vibrate('long');
            });
        }
        
        // Reconocimiento de Voz Setup
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        let recognition = null;
        if (SpeechRecognition) {
            recognition = new SpeechRecognition();
            recognition.lang = 'es-ES';
            recognition.interimResults = false;

            recognition.onstart = () => {
                if ($voiceInputBtn) $voiceInputBtn.textContent = '🗣️ ESCUCHANDO... HABLE AHORA';
                if ($voiceInputBtn) $voiceInputBtn.classList.add('btn-listening');
                if ($currentState) $currentState.textContent = "ESCRIBIR O HABLAR DESTINO... ESCUCHANDO...";
            };

            recognition.onresult = (event) => {
                const speechResult = event.results[0][0].transcript;
                if ($destinationText) $destinationText.value = speechResult;
                if ($currentState) $currentState.textContent = `Voz detectada: "${speechResult}". Presione Iniciar Guía.`;
                speak(`Destino reconocido: ${speechResult}. Presione Iniciar Guía.`);
                if (recognition) recognition.stop();
            };

            recognition.onerror = (event) => {
                if ($voiceInputBtn) $voiceInputBtn.textContent = '🎤 Hablar Destino';
                if ($voiceInputBtn) $voiceInputBtn.classList.remove('btn-listening');
                if ($currentState) $currentState.textContent = `Error de voz: ${event.error}. Intente de nuevo.`;
                speak("Error en el reconocimiento de voz. Intente de nuevo o escriba el destino.");
            };

            recognition.onend = () => {
                if ($voiceInputBtn) $voiceInputBtn.textContent = '🎤 Hablar Destino';
                if ($voiceInputBtn) $voiceInputBtn.classList.remove('btn-listening');
            };

        } else {
            if ($voiceInputBtn) $voiceInputBtn.textContent = 'Voz no soportada';
            if ($voiceInputBtn) $voiceInputBtn.disabled = true;
        }

        // ====================================================================
        // LÓGICA DE INICIO Y BOOTSTRAP
        // ====================================================================
        
        if ($startSplashBtn) {
            $startSplashBtn.addEventListener('click', () => {
                // 1. Ocultar Splash Screen
                if ($splashScreen) $splashScreen.style.opacity = '0';
                setTimeout(() => {
                    if ($splashScreen) $splashScreen.style.display = 'none';
                    // 2. Mostrar App
                    if ($appContainer) $appContainer.style.display = 'flex';
                    // 3. Iniciar mensaje de bienvenida
                    if ($currentState) $currentState.textContent = mapData.nodes['N01'].instructions.default;
                    speak(mapData.nodes['N01'].instructions.default);
                }, 500); 
            });
        }


        window.onload = function() {
            setupIndex();
            populateDatalist();
            
            // Asegurar que el botón de contraste inferior refleje el estado inicial
            if ($bottomContrastBtn) $bottomContrastBtn.textContent = 'Contraste';
            if ($bottomStairsBtn) $bottomStairsBtn.textContent = 'Accesible (ON)';
            if ($bottomGeminiBtn) $bottomGeminiBtn.textContent = 'Asistente IA';
            
            // Ocultar sección de Gemini por defecto
            if ($geminiQuerySection) $geminiQuerySection.classList.add('hidden');
        }

    </script>
</body>
</html>
