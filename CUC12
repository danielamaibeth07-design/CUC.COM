        function speak(text) {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'es-ES';
                utterance.pitch = 1.0;
                utterance.rate = 1.1;
                speechSynthesis.cancel();
                speechSynthesis.speak(utterance);
            } else {
                console.warn("Speech Synthesis no soportado.");
            }
        }

        function vibrate(type) {
            if ('vibrate' in navigator) {
                switch (type) {
                    case 'turn': navigator.vibrate([200, 100, 200]); break;
                    case 'long': navigator.vibrate(800); break;
                    default: navigator.vibrate(0); break;
                }
            } else {
                console.warn("Vibration API no soportado.");
            }
        }

        function updateInstruction(text) {
            if ($instructionText) $instructionText.textContent = text;
