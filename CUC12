    <style>
        /* Tipografía moderna y nítida */
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Space+Mono:wght@400;700&display=swap');
        
        html {
            font-family: 'Space Mono', monospace; 
        }
        h1, h2 {
            font-family: 'Orbitron', sans-serif;
        }

        /* Colores de la paleta "Fiery Fusion" para Alto Contraste */
        :root {
            --color-neon-text: #FFFF00;
            --color-neon-accent: #FF8C00;
            --color-neon-shadow: #FF4500;
            --color-panel-bg: #0c0c0c;
        }

        /* =========================
           Botones modernos (pill)
           ========================= */
        @keyframes gradientMove {
            0% { background-position: 0% 50% }
            50% { background-position: 100% 50% }
            100% { background-position: 0% 50% }
        }

        @keyframes pulseGlow {
            from { box-shadow: 0 0 12px rgba(236,72,153,.55) }
            to   { box-shadow: 0 0 28px rgba(236,72,153,.75) }
        }

        /* Estilos base para el modo de Alto Contraste (Predeterminado) */
        .high-contrast {
            background-color: #000000;
            color: var(--color-neon-text);
            position: relative; 
        }
        
        /* Contenedor principal de la aplicación */
        #app {
            background-color: transparent; 
            min-height: calc(100vh - 4rem); /* Menos el alto de la barra inferior */
            display: none; /* Oculto al inicio */
            padding-bottom: 4rem; /* Espacio para la barra de comandos */
            overflow-y: auto;
        }

        /* Estilos de la Splash Screen */
        #splash-screen {
            background-color: #000000;
            color: var(--color-neon-text);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 1000;
            transition: opacity 0.5s ease;
        }
        
        /* Barra de comandos fija en la parte inferior (estilo nativo) */
        #bottom-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 4rem;
            background-color: #000000;
            border-top: 2px solid var(--color-neon-accent);
            z-index: 50;
        }

        .high-contrast .input-field {
            background-color: #1a1a1a;
            color: var(--color-neon-text);
            border: 2px solid var(--color-neon-accent);
            box-shadow: 0 0 5px var(--color-neon-shadow);
        }
        .high-contrast .panel {
            background-color: var(--color-panel-bg);
            border: 2px solid var(--color-neon-text);
            box-shadow: 0 0 10px rgba(255, 255, 0, 0.5); 
            backdrop-filter: blur(5px); 
        }
        .high-contrast .bg-emergency { background-color: #FF0000; color: var(--color-neon-text); box-shadow: 0 0 10px #FF0000; }
        .high-contrast .bg-incident { background-color: #FF8800; color: #000000; box-shadow: 0 0 8px #FF8800; }
        .high-contrast .bg-stop { background-color: #880000; color: var(--color-neon-text); }
        .high-contrast .text-secondary { color: var(--color-neon-accent); }
        
        /* --- CLASES DE BOTONES MODERNOS --- */
        @layer components {
            /* Base pill */
            .btn {
                @apply inline-flex items-center justify-center rounded-full gap-2
                       px-6 py-3 font-semibold tracking-wide
                       transition-all duration-200 select-none
                       focus:outline-none focus-visible:ring-2 ring-offset-2
                       active:scale-[.98];
            }

            /* Tamaños */
            .btn-sm { @apply px-4 py-2 text-sm; }
            .btn-lg { @apply px-7 py-4 text-xl; }

            /* Estilos */
            .btn-gradient {
                @apply text-black shadow-lg shadow-orange-500/20;
                background-image: linear-gradient(90deg,#f97316,#fb7185,#60a5fa);
                background-size: 200% 200%;
                animation: gradientMove 6s ease infinite;
            }
            .btn-gradient:hover { @apply shadow-orange-500/40; }

            .btn-primary {
                @apply bg-orange-500 text-black shadow-lg shadow-orange-500/25 hover:bg-orange-400;
            }

            .btn-outline {
                @apply border-2 border-white/30 text-white/90 hover:bg-white/10;
            }

            .btn-ghost {
                @apply bg-white/5 text-white/90 hover:bg-white/10;
            }

            /* Semánticos */
            .btn-success {
                @apply bg-emerald-400 text-black hover:bg-emerald-300 shadow-lg shadow-emerald-400/25;
            }
            .btn-danger {
                @apply bg-rose-500 text-white hover:bg-rose-400 shadow-lg shadow-rose-500/30;
            }
            .btn-warning {
                @apply bg-amber-400 text-black hover:bg-amber-300 shadow-lg shadow-amber-400/25;
            }

            /* Botón circular icon-only */
            .btn-icon {
                @apply rounded-full h-12 w-12 inline-flex items-center justify-center
                       bg-white/10 hover:bg-white/20 text-white;
            }

            /* Estado “escuchando” (glow) */
            .btn-listening {
                @apply ring-2 ring-pink-400/70 shadow-[0_0_20px_rgba(236,72,153,.6)];
                animation: pulseGlow 1s ease-in-out infinite alternate;
            }
        }

        /* Accesibilidad: alto contraste sobre fondo negro */
        .high-contrast .btn-outline { @apply border-yellow-300/60 text-yellow-200; }
        .high-contrast .btn-ghost   { @apply text-yellow-200; }
        .high-contrast .btn, .high-contrast .btn-gradient { @apply ring-yellow-300/40; }

